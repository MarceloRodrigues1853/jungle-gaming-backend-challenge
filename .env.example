POSTGRES_DB=jungle_gaming
POSTGRES_USER=jungle_app
POSTGRES_PASSWORD=local_dev_only
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local_admin_only

HTTP_ADDRESS=0.0.0.0:8090
DATABASE_URL=postgres://jungle_app:local_dev_only@postgres:5432/jungle_gaming?sslmode=disable
OIDC_INTROSPECTION_URL=http://keycloak:8080/realms/jungle-dev/protocol/openid-connect/token/introspect
OIDC_INTROSPECTION_CLIENT_ID=jungle-api
OIDC_INTROSPECTION_CLIENT_SECRET=jungle-api-introspection-secret
PROVIDER_CLIENT_ID=provider-a
PROVIDER_ID=provider-a
INTERNAL_CLIENT_ID=wallet-internal

AWS_REGION=us-east-1
SQS_ENDPOINT=http://localstack:4566
SQS_INPUT_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_OUTPUT_QUEUE_URL=http://localstack:4566/000000000000/jungle-events.fifo
SQS_CONSUMER_NAME=wager-transactions-v1
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_MESSAGES=10

OUTBOX_POLL_INTERVAL=1s
OUTBOX_LOCK_DURATION=30s
OUTBOX_BATCH_SIZE=20
REFERENCE_POLL_INTERVAL=1s
REFERENCE_LOCK_DURATION=30s
REFERENCE_BATCH_SIZE=20
REFERENCE_MAX_ATTEMPTS=10
